#!/bin/bash
# intelligence — the CLI for Intelligence Packages and the sync engine.
#
# Dispatcher only: each command lives in commands/<name>.sh so commands can be
# ported to Node one at a time without touching the others. The engine is the
# bash engine shipped next to the CLI.

set -euo pipefail

case "$0" in
    */*) CLI_DIR="${0%/*}"; [ -n "$CLI_DIR" ] || CLI_DIR="/" ;;
    *) CLI_DIR="." ;;
esac
# An absolute spelling without `.` or `..` segments or doubled slashes is
# already what `cd && pwd` prints; on Git Bash that subshell costs a fork.
case "$CLI_DIR" in
    */./*|*/.|*/../*|*/..|*//*|[!/]*) CLI_DIR="$(cd "$CLI_DIR" && pwd)" ;;
esac
export CLI_DIR

# Engine discovery, by role (sync.sh + VERSION). The repo and the npm package
# ship one layout — <root>/{cli,engine,packages/sync} — so there is a single
# candidate rather than a per-distribution list. CLI_DIR is already the logical
# `pwd` spelling, so its textual parent is what `cd "$CLI_DIR/.."` would print.
CLI_ROOT="${CLI_DIR%/*}"
IS_ENGINE_DIR=""
if [ -f "$CLI_DIR/../engine/sync.sh" ] && [ -f "$CLI_DIR/../engine/VERSION" ]; then
    IS_ENGINE_DIR="$CLI_ROOT/engine"
fi
if [ -z "$IS_ENGINE_DIR" ]; then
    echo "ERROR: bundled sync engine not found next to the CLI ($CLI_DIR)." >&2
    echo "       Reinstall: npm i -g ${INTELLIGENCE_NPM_PACKAGE:-<the CLI package>}" >&2
    exit 1
fi
export IS_ENGINE_DIR

# The engine's own content, shipped beside the engine as the seed for the
# @ainova-systems/sync package at exactly this CLI's version. Separate from the
# engine dir: the store must receive rules/agents/skills, never engine scripts.
IS_BUNDLED_PKG_DIR=""
if [ -d "$CLI_DIR/../packages/sync" ]; then
    IS_BUNDLED_PKG_DIR="$CLI_ROOT/packages/sync"
fi
export IS_BUNDLED_PKG_DIR

cmd="${1:-}"
case "$cmd" in
    ""|help|-h|--help)
        engine_ver="$(tr -d ' \t\r\n' < "$IS_ENGINE_DIR/VERSION")"
        cat <<EOF
intelligence — build, version and distribute AI agent intelligence
(engine $engine_ver${INTELLIGENCE_NPM_VERSION:+, package $INTELLIGENCE_NPM_VERSION})

Usage: intelligence <command> [args]

  init [--preview|--apply]  Initialize, convert, restore or align this project
    --targets a,b --dir name --bare --no-sync   New-project options
    --force               Accept a dirty worktree during legacy project conversion
  sync [adapter] [--compact] [--force] [--check]  Restore locked content, then render enabled adapters
    --compact            On success show context, warnings and final status; on failure show diagnostics
    --force              Render again and refresh discovery of unconfigured source directories
    --check              Change no generated file; exit 0 when up to date, 2 when sync is needed
  update [@scope/name]    Show an update plan; ask before applying it
    --preview             Show the plan without asking or writing
    --apply               Apply the plan without asking
    --latest              Move one named package past its range to the newest version
  upgrade [--next] [--preview|--apply]  Replace the installed CLI with the newest npm version
    --next                Follow the prerelease line instead of the stable one
  package <command>       add | remove | list | search
  source <command>        add | remove | list — the sources: block (own directories)
  adapter <command>       list | create | enable | disable | remove
  status [--check]        Project state; --check runs deep consistency checks
  registry <list|add|remove>  Manage the trusted registry list (add <repo-url>)
  version                 Print CLI and engine versions
EOF
        exit 0
        ;;
    version|-v|--version)
        engine_ver="$(tr -d ' \t\r\n' < "$IS_ENGINE_DIR/VERSION")"
        echo "${INTELLIGENCE_NPM_VERSION:-$engine_ver} (engine $engine_ver)"
        exit 0
        ;;
esac
shift

# The command word builds a path — allow exactly lowercase words, so
# `intelligence ../x` can never exec a neighbouring script.
case "$cmd" in
    *[!a-z-]*|-*)
        echo "ERROR: unknown command '$cmd'. Run 'intelligence help'." >&2
        exit 1
        ;;
esac
cmd_file="$CLI_DIR/commands/$cmd.sh"
if [ ! -f "$cmd_file" ]; then
    case "$cmd" in
        adapters)
            echo "ERROR: unknown command 'adapters'. Use the singular command: intelligence adapter list" >&2
            exit 1
            ;;
        packages)
            echo "ERROR: unknown command 'packages'. Use the singular command: intelligence package list" >&2
            exit 1
            ;;
        sources)
            echo "ERROR: unknown command 'sources'. Use the singular command: intelligence source list" >&2
            exit 1
            ;;
        registries)
            echo "ERROR: unknown command 'registries'. Use the singular command: intelligence registry list" >&2
            exit 1
            ;;
    esac
    echo "ERROR: unknown command '$cmd'. Run 'intelligence help'." >&2
    exit 1
fi
# `sync` runs on every save hook and CI check, so it runs in this process: a
# second bash start is a large share of an unchanged sync on Git Bash. It
# exits on every path and reads nothing of this script but the exports.
if [ "$cmd" = sync ]; then
    # shellcheck source=commands/sync.sh
    source "$cmd_file"
    exit $?
fi
exec bash "$cmd_file" "$@"
